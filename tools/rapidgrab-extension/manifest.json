{
  "manifest_version": 3,
  "name": "RapidGrab",
  "version": "1.0",
  "description": "Send the current page's download link to RapidGrab for confirmation.",
  "permissions": ["cookies", "contextMenus", "nativeMessaging", "tabs"],
  "action": { "default_title": "Download with RapidGrab" },
  "background": { "service_worker": "background.js" }
}
