{
  "manifest_version": 3,
  "name": "RapidGrab",
  "version": "1.2",
  "description": "Send the current page's download link to RapidGrab for confirmation.",
  "permissions": ["cookies", "contextMenus", "nativeMessaging", "tabs", "webRequest", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Download with RapidGrab" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
