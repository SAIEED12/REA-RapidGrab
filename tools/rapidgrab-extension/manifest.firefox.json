{
  "manifest_version": 3,
  "name": "RapidGrab",
  "version": "1.5",
  "description": "Send the current page's download link to RapidGrab for confirmation.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rapidgrab@rapidgrab.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["cookies", "contextMenus", "nativeMessaging", "tabs", "webRequest", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Download with RapidGrab" },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
